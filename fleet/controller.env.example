# Settings for the controller. Copy to /etc/uninvited/controller.env on the controller; never commit the real one.
# systemd reads this file: comments must be on their own lines, never after a value.
UNINVITED_DATA=/var/lib/uninvited
UNINVITED_FLEET=/etc/uninvited/fleet.json
# Production environment key (server-side), readable only by the service
UNINVITED_FLAGSMITH_KEY_FILE=/etc/uninvited/flagsmith.key
# 32 random bytes for the keyed hashes; never leaves the controller
UNINVITED_HASH_KEY_FILE=/etc/uninvited/hash.key
# private key that may only stream the SSH log
UNINVITED_LOG_KEY=/etc/uninvited/ssh/log
# private key that may only send "ban <ip> <seconds>"
UNINVITED_BAN_KEY=/etc/uninvited/ssh/ban
UNINVITED_KNOWN_HOSTS=/etc/uninvited/ssh/known_hosts
# the admin's IP, comma-separated if more (private and reserved ranges are always protected)
UNINVITED_PROTECTED=192.0.2.10
UNINVITED_ENROL_FROM=2026-11-26T14:00:00+05:30
UNINVITED_ENROL_UNTIL=2026-11-27T15:00:00+05:30
UNINVITED_WINDOW_HOURS=12
# optional: iptoasn.com's ip2asn-v4-u32.tsv.gz (public domain), for the ASN and country at enrolment
UNINVITED_ASN_TABLE=/opt/uninvited/ip2asn-v4-u32.tsv.gz
