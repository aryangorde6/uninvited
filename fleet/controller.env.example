# Settings for the controller (copy to /etc/uninvited/controller.env on the controller; never commit the real one).
UNINVITED_DATA=/var/lib/uninvited
UNINVITED_FLEET=/etc/uninvited/fleet.json
UNINVITED_FLAGSMITH_KEY_FILE=/etc/uninvited/flagsmith.key   # Production environment key, readable only by the service
UNINVITED_HASH_KEY_FILE=/etc/uninvited/hash.key             # 32 random bytes; never leaves the controller
UNINVITED_LOG_KEY=/etc/uninvited/ssh/log                    # private key: may only stream the SSH log
UNINVITED_BAN_KEY=/etc/uninvited/ssh/ban                    # private key: may only send "ban <ip> <seconds>"
UNINVITED_KNOWN_HOSTS=/etc/uninvited/ssh/known_hosts
UNINVITED_PROTECTED=192.0.2.10                              # the admin's IP (private ranges are always protected)
UNINVITED_ENROL_FROM=2026-11-26T15:00:00+05:30
UNINVITED_ENROL_UNTIL=2026-11-27T16:00:00+05:30
UNINVITED_WINDOW_HOURS=12
