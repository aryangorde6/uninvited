[Unit]
Description=Uninvited controller (follows the fleet's SSH logs, bans, talks to Flagsmith)
After=network-online.target
Wants=network-online.target

[Service]
User=uninvited
Group=uninvited
EnvironmentFile=/etc/uninvited/controller.env
WorkingDirectory=/opt/uninvited
# not -I: python -m must find the package in WorkingDirectory, which is root-owned and read-only to this user
ExecStart=/opt/uninvited/.venv/bin/python -m uninvited.controller
Restart=always
RestartSec=10
# Stop with SIGINT, not the default SIGTERM: Python then runs the controller's cleanup, which sends
# Flagsmith any events still buffered (up to a minute of came_back events) before it exits.
KillSignal=SIGINT
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/uninvited

[Install]
WantedBy=multi-user.target
